# Autenticação da API de voos (header x-api-key)
APIKEY=troque-esta-chave

# Porta do servidor (Coolify/local)
PORT=8000

# Gemini — cole aqui a chave do Google AI Studio
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Fallback do Google Flights no Chromium (opcional)
# GOOGLE_FLIGHTS_HEADED=1
# GOOGLE_FLIGHTS_DUMP=1
